<?xml version="1.0" ?>
<odoo>
    <record id="hms_department_view_form" model="ir.ui.view">
        <field name="name">hms.department.form</field>
        <field name="model">hms.department</field>
        <field name="arch" type="xml">
            <form string="Department">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="capacity" />
                            <field name="is_opened" />
                        </group>
                    </group>
                    <field name="patient_ids" widget="many2many_tags" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="hms_department_view_tree" model="ir.ui.view">
        <field name="name">hms.department.tree</field>
        <field name="model">hms.department</field>
        <field name="arch" type="xml">
            <list string="Departments">
                <field name="name" />
                <field name="capacity" />
                <field name="is_opened" />
                <field name="patient_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>

    <record id="hms_department_action" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">hms.department</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
    id="hms_menu_departments"
    name="Departments"
    parent="hms_menu_root"
    action="hms_department_action"
    sequence="20"
  />
</odoo>
