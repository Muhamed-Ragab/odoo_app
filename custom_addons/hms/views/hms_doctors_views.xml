<?xml version="1.0"?>
<odoo>
    <record id="hms_doctors_view_form" model="ir.ui.view">
        <field name="name">hms.doctors.form</field>
        <field name="model">hms.doctors</field>
        <field name="arch" type="xml">
            <form string="Doctor">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="first_name" placeholder="First Name"/>
                            <field name="last_name" placeholder="Last Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="image" widget="image"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hms_doctors_view_tree" model="ir.ui.view">
        <field name="name">hms.doctors.tree</field>
        <field name="model">hms.doctors</field>
        <field name="arch" type="xml">
            <list string="Doctors">
                <field name="first_name"/>
                <field name="last_name"/>
            </list>
        </field>
    </record>

    <record id="hms_doctors_action" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hms.doctors</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hms_menu_doctors" name="Doctors" parent="hms_menu_root" action="hms_doctors_action" sequence="30"/>
</odoo>
