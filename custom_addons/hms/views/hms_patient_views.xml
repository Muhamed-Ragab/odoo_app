<?xml version="1.0" ?>
<odoo>
    <record id="hms_patient_view_form" model="ir.ui.view">
        <field name="name">hms.patient.form</field>
        <field name="model">hms.patient</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}" statusbar_visible="undetermined,good,fair,serious" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="full_name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="first_name" placeholder="First Name" />
                            <field name="last_name" placeholder="Last Name" />
                            <field name="email" />
                            <field name="birthdate" />
                            <field name="age" />
                            <field name="blood_type" />
                            <field name="pcr" />
                        </group>
                        <group>
                            <field name="cr_ratio" required="pcr" />
                            <field name="image" widget="image" />
                            <field name="department_ids" widget="many2many_tags" domain="[('is_opened', '=', True)]" />
                            <field name="doctor_ids" widget="many2many_tags" readonly="not department_ids" />
                        </group>
                    </group>
                    <notebook>
                        <page string="History">
                            <field name="history" placeholder="Patient medical history..." invisible="age &lt; 50" />
                        </page>
                        <page string="Address">
                            <field name="address" />
                        </page>
                        <page string="Logs">
                            <field name="log_ids" readonly="1">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="created_by" readonly="1" />
                                    <field name="date" readonly="1" />
                                    <field name="description" readonly="1" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hms_patient_view_tree" model="ir.ui.view">
        <field name="name">hms.patient.tree</field>
        <field name="model">hms.patient</field>
        <field name="arch" type="xml">
            <list string="Patients">
                <field name="full_name" />
                <field name="email" />
                <field name="blood_type" />
                <field name="state" />
                <field name="department_ids" widget="many2many_tags" />
                <field name="pcr" />
                <field name="age" />
                <field name="cr_ratio" />
            </list>
        </field>
    </record>

    <record id="hms_patient_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hms.patient</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new patient</p>
        </field>
    </record>

    <menuitem id="hms_menu_root" name="HMS" sequence="100" web_icon="hms,static/description/icon.png" />
    <menuitem id="hms_menu_patients" name="Patients" parent="hms_menu_root" action="hms_patient_action" sequence="10" />
</odoo>
