<?xml version="1.0" ?>
<odoo>
    <!-- Add related_patient_id inside Misc group in Sales & Purchase tab -->
    <record id="view_partner_form_hms_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.hms.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <field name="ref" position="after">
                <field name="related_patient_id" />
            </field>
        </field>
    </record>

    <!-- Add website field to tree/list view -->
    <record id="view_partner_tree_hms_inherit" model="ir.ui.view">
        <field name="name">res.partner.tree.hms.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="email" position="after">
                <field name="website" />
            </field>
        </field>
    </record>
</odoo>
